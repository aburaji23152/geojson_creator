{
  "name": "架空行政区画 GeoJSON エディタ | GeoCraft Studio",
  "short_name": "GeoCraft N03",
  "description": "架空の都道府県・市区町村境界を作成・編集し、国土数値情報(N03)準拠のGeoJSONを出力できる地図エディタ",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/geo+json": [".geojson"],
        "application/json": [".json"]
      }
    }
  ]
}